# Compose reads runtime secrets from .env by default.
BOT_TOKEN=your_discord_bot_token
DISCORD_APPLICATION_ID=your_discord_app_id
GPT_KEY=your_openai_api_key

# Local Mongo used by compose.yaml.
LOCAL_MONGO_ROOT_USERNAME=neverbot
LOCAL_MONGO_ROOT_PASSWORD=replace-with-a-long-url-safe-password
MONGO_DB_NAME=neverbot

# API exposure. Keep APP_HOST=127.0.0.1 when using a local reverse proxy.
APP_HOST=127.0.0.1
APP_PORT=3500
PORT=3500
API_URL=http://localhost:3500/

# Optional runtime flags.
METRICS_HIGH_CARD=false
WEB_SEARCH_ENABLED=false
ALLOWED_ORIGINS=

# Optional Google OCR/Translate credentials.
# GOOGLE_CLOUD_CREDENTIALS_PATH=/run/secrets/google-cloud-credentials.json
